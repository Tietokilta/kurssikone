{
  "name": "KurssiKone",
  "description": "Adds extra features directly to Aalto University's Sisu, including course reviews, past exams and an improved timeline view!",
  "version": "3.0.0",
  "manifest_version": 3,
  "permissions": [
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "https://api.kurssikone.com/*",
    "https://sisu.aalto.fi/*",
    "https://tenttiarkisto.fi/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "96": "icon96.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://sisu.aalto.fi/*"
      ],
      "js": [
        "/static/js/main.js"
      ]
    }
  ]
}
