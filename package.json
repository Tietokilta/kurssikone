{
  "name": "kurssikone-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "docker compose -f packages/backend/docker-compose.yml up -d && concurrently --names \"web,extension,backend\" --prefix-colors \"cyan,magenta,yellow\" \"npm run dev --prefix packages/web\" \"npm run dev --prefix packages/extension\" \"docker compose -f packages/backend/docker-compose.yml logs -f backend\"",
    "dev:extension": "npm run dev --prefix packages/extension",
    "dev:web": "npm run dev --prefix packages/web",
    "dev:backend": "docker compose -f packages/backend/docker-compose.yml up",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces",
    "test:e2e": "npm run test:e2e --workspaces --if-present",
    "build:extension": "npm run build-release  --prefix packages/extension",
    "release:extension": "npm run release --prefix packages/extension"
  },
  "devDependencies": {
    "@aikidosec/safe-chain": "^1.4.4",
    "concurrently": "^9.0.0"
  }
}
