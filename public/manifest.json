{
  "name": "Sisu Course Reviewer",
  "description": "Sisu Course Reviewer",
  "version": "1.0.0",
  "manifest_version": 2,
  "browser_action": {
    "default_popup": "index.html",
    "default_title": "Sisu Course Reviewer",
    "default_icon": {
      "48": "logo48.png",
      "96": "logo96.png"
    }
  },
  "icons": {
    "48": "logo48.png",
    "96": "logo96.png"
  },
  "content_scripts": [
    {
      "matches": ["https://sisu.aalto.fi/*"],
      "js": ["/static/js/main.js"]
    }
  ]
}
